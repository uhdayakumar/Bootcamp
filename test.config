server {
    listen 80;
    server_name your_domain.com www.your_domain.com; # Replace with your domain or IP address

    # Handle static files directly through NGINX for optimal performance
    location /static/ {
        alias /var/www/your_app/static/; 
    }

    # Proxy all other traffic to the Python application server
    location / {
        proxy_pass http://127.0.0.1:8000; # The address where Gunicorn/Uvicorn is running
        
        # Forward essential HTTP headers to the Python backend
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support (Optional, useful for FastAPI/Starlette)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $ puppets_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Prevent timeouts for long-running Python requests
        proxy_connect_timeout 90s;
        proxy_read_timeout 90s;
    }
}
